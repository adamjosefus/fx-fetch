{
  "name": "fx-fetch",
  "version": "2.0.0-alpha.0",
  "description": "Simple, immutable, clonable, and effect-based HTTP fetching.",
  "keywords": [
    "clonable",
    "EffectTS",
    "fetch",
    "http",
    "immutable",
    "mock",
    "request",
    "response",
    "service",
    "typescript",
    "url"
  ],
  "homepage": "https://adamjosefus.github.io/fx-fetch/",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamjosefus/fx-fetch.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "zshy -p ./src/tsconfig.json",
    "check": "biome check . --error-on-warnings",
    "check:write": "biome check . --write --error-on-warnings",
    "test": "vitest run ./src ./src-browser ./src-bun ./src-deno ./src-node",
    "validate": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.1.1",
    "effect": "^4.0.0-beta.94",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zshy": "^0.7.3"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1",
    "effect": "^4"
  },
  "zshy": {
    "exports": {
      ".": "./src/index.ts"
    },
    "cjs": false,
    "esm": true
  }
}
