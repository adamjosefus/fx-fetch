{
  "name": "fx-fetch",
  "version": "2.0.0-alpha.0",
  "description": "Simple, immutable, clonable, and effect-based HTTP fetching.",
  "keywords": [
    "clonable",
    "EffectTS",
    "fetch",
    "http",
    "immutable",
    "mock",
    "request",
    "response",
    "service",
    "typescript",
    "url"
  ],
  "homepage": "https://adamjosefus.github.io/fx-fetch/",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamjosefus/fx-fetch.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "check": "biome check . --error-on-warnings",
    "check:write": "biome check . --write --error-on-warnings",
    "clean": "tsc --build --clean",
    "test": "tsc --project src/core/tsconfig.test.json && vitest run ./src",
    "validate": "tsc --build --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "effect": "^4.0.0-beta.98",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1",
    "@types/bun": "^1",
    "@types/node": "^26",
    "effect": "^4"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
