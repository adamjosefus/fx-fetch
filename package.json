{
  "name": "fx-fetch",
  "version": "2.0.0-alpha.0",
  "description": "Simple, immutable, clonable, and effect-based HTTP fetching.",
  "keywords": [
    "clonable",
    "EffectTS",
    "fetch",
    "http",
    "immutable",
    "mock",
    "request",
    "response",
    "service",
    "typescript",
    "url"
  ],
  "homepage": "https://adamjosefus.github.io/fx-fetch/",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamjosefus/fx-fetch.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "check": "biome check . --error-on-warnings",
    "check:write": "biome check . --write --error-on-warnings",
    "clean": "tsc --build --clean",
    "test": "vitest run ./src",
    "validate": "tsc --build --noEmit && tsc --project src/core/tsconfig.test.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "effect": "^4.0.0-beta.98",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1",
    "@types/bun": "^1",
    "@types/node": "^26",
    "effect": "^4"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
